# Discord Bot Configuration
# DO NOT commit this file with real values! This is just a template.

# Your Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_token_here

# Your Hugging Face API Token (from huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# GitHub Raw URL to your guides file
